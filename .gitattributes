# Sprint-5.7 E: enforce LF line endings repo-wide — ends recurring CRLF↔LF churn.
* text=auto eol=lf

# Windows batch files must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — never EOL-munge
*.pkl  binary
*.gz   binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.zip  binary

# DB: kept as LFS safety for DB snapshots (build-on-deploy means the DB is
# normally NOT in the repo; Render builds it via build_db.py at deploy).
*.db filter=lfs diff=lfs merge=lfs -text
